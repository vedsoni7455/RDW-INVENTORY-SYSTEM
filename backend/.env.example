# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# SUPABASE POSTGRESQL CONFIGURATION
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# COMPANY EMAIL NOTIFICATIONS (NODEMAILER SMTP)
COMPANY_EMAIL=inventory@rdwrestaurant.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@rdwrestaurant.com
SMTP_PASS=your-app-password
SMTP_FROM="RDW Inventory System <alerts@rdwrestaurant.com>"

# SMS TEXT MESSAGE NOTIFICATIONS (TWILIO / SMS API)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# EXPO PUSH NOTIFICATION ACCESS TOKEN
EXPO_ACCESS_TOKEN=your_expo_access_token
